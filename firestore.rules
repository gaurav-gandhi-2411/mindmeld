rules_version = '2';

// Mindmeld 6a (Social) + 6b (Notifications) — Firestore security rules.
//
// Data model (see spec.md #6a, spec-phase6b.md):
//   users/{uid}                                  { displayName, createdAt, groupIds[],
//                                                    fcmToken, notifLang, timezone,
//                                                    notifPendingAction, notifUpdatedAt }
//   groups/{groupId}                              { name, code, createdBy, memberUids[], createdAt }
//   groups/{groupId}/days/{date}/results/{uid}    { uid, displayName, outcome, guessesUsed,
//                                                    par, scoreVsPar, lang, finishedAt }
//   codes/{code}                                  { groupId }   // join-by-code lookup
//
// Posture: friend-group social trust (spec's "Anti-cheat posture" section). Rules stop
// tampering with OTHERS' data and bound your OWN result to sane ranges; a user forging
// their own client-reported score is an accepted MVP risk, not a hole these rules try to
// close.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupData) {
      return isSignedIn() && request.auth.uid in groupData.memberUids;
    }

    function isValidDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // displayName is only required to be well-formed WHEN present — 6b lets a
    // player opt into notifications without ever touching Social, so a
    // users/{uid} doc can legitimately exist with no displayName at all
    // (leaderboard code already falls back to "Anonymous" for that case).
    function isValidDisplayName(data) {
      return !('displayName' in data) || (
        data.displayName is string &&
        data.displayName.size() > 0 &&
        data.displayName.size() <= 40 &&
        isValidNameCharset(data.displayName)
      );
    }

    // Defense-in-depth charset check, mirroring the client-side stripping in
    // app/lib/social/name_sanitizer.dart (see its doc comment for the full
    // codepoint rationale): rejects control characters (Cc: C0 controls,
    // DEL, C1 controls), zero-width/invisible characters, and RTL/bidi
    // embedding/override/isolate characters. The richer profanity/
    // reserved-word moderation stays client-side only (per this app's
    // launch-hardening spec) -- this is just what CAN be enforced here
    // (length above, charset here) as a backstop against a client that
    // bypasses the sanitizer (e.g. a modified build or direct API write).
    //
    // RE2 (Firestore rules' regex engine) has no lookaround/backreferences,
    // so this is phrased as "every character is OUTSIDE the forbidden set"
    // (anchored ^...$ over a negated character class) rather than a
    // negative match anywhere in the string.
    function isValidNameCharset(s) {
      return s.matches('^[^\\x{0000}-\\x{001F}\\x{007F}-\\x{009F}\\x{200B}-\\x{200D}\\x{FEFF}\\x{2060}\\x{061C}\\x{202A}-\\x{202E}\\x{2066}-\\x{2069}]*$');
    }

    // 6b notification fields — all optional, each validated only when present
    // so a write that touches just one of them (e.g. the Settings toggle
    // clearing fcmToken on unsubscribe) never has to resend the others.
    // notifUpdatedAt must be the server timestamp (no backdating), same
    // pattern as results/{uid}.finishedAt below.
    function isValidNotifFields(data) {
      return (!('fcmToken' in data) || data.fcmToken == null ||
                (data.fcmToken is string && data.fcmToken.size() <= 4096))
        && (!('notifLang' in data) || data.notifLang == null ||
              data.notifLang in ['en', 'hi-en'])
        && (!('timezone' in data) || data.timezone == null ||
              (data.timezone is string && data.timezone.size() <= 64))
        && (!('notifPendingAction' in data) || data.notifPendingAction == null ||
              data.notifPendingAction in ['subscribe', 'unsubscribe'])
        && (!('notifUpdatedAt' in data) || data.notifUpdatedAt == request.time);
    }

    // -------------------------------------------------------------------
    // users/{uid} — profile (display name, leaderboard identity) +
    // 6b notification subscription state.
    // -------------------------------------------------------------------
    match /users/{uid} {
      // Single-doc get only. Reading another member's display name for the
      // "not played yet" leaderboard rows requires their uid, which is only
      // ever learned via a group's memberUids — never enumerable, since
      // `list` is denied below.
      allow get: if isSignedIn();
      allow list: if false;

      // A user may only ever create/update their OWN profile doc. keys()
      // .hasOnly(...) closes an extra-fields gap found in the 2026-07-11
      // re-audit: isValidDisplayName()/isValidNotifFields() only constrain
      // fields THEY know about when present -- neither denies a write that
      // also smuggles in an extra, unlisted top-level key (Firestore rules
      // don't implicitly forbid unknown fields). The allow-list below is
      // exactly this file's documented users/{uid} data model (see the
      // header comment) -- a legitimate client-app write never needs
      // anything outside it.
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'displayName', 'createdAt', 'groupIds',
             'fcmToken', 'notifLang', 'timezone', 'notifPendingAction', 'notifUpdatedAt'
           ])
        && isValidDisplayName(request.resource.data)
        && isValidNotifFields(request.resource.data);

      // Data-deletion (Play/GDPR): a user may delete ONLY their own profile
      // doc. This does not touch group membership or past result docs --
      // see groups/{groupId}'s self-removal update rule below, and
      // docs/privacy-policy.md for what "delete my data" covers overall.
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------
    // codes/{code} — join-by-code lookup (code -> groupId)
    // -------------------------------------------------------------------
    match /codes/{code} {
      // Public single-doc get so a user can resolve a code to a groupId
      // before joining. Never listable — that would enumerate every group's
      // invite code.
      allow get: if isSignedIn();
      allow list: if false;

      // Created atomically alongside its group (same batched write) by the
      // group's creator only; immutable afterwards — a code can never be
      // repointed at a different group.
      allow create: if isSignedIn()
        && request.resource.data.groupId is string
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------
    // groups/{groupId}
    // -------------------------------------------------------------------
    match /groups/{groupId} {
      // Single-doc get is open to ANY signed-in user holding the groupId —
      // not membership-gated. Consequence: the member roster (uids) and,
      // transitively via users/{uid} get, their display names are visible
      // to anyone with a join link/code, whether or not they ever join.
      // Accepted for the friend-group trust model (spec's "Anti-cheat
      // posture"): groupId is only ever learned via an unguessable code
      // lookup or existing membership, and the doc holds no puzzle/spoiler
      // data. `list` (queries) IS restricted to members, so groups can't be
      // enumerated/browsed at large.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      // keys().hasOnly(...) closes the same extra-fields gap noted on
      // users/{uid} above -- the allow-list matches this file's documented
      // groups/{groupId} data model (header comment).
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'createdBy', 'memberUids', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && isValidNameCharset(request.resource.data.name)
        && request.resource.data.code is string;

      // Join flow: the ONLY allowed mutation is adding your own uid to
      // memberUids. Every other field must stay identical; no removing or
      // adding anyone else's uid; you cannot add yourself twice.
      function isJoinUpdate() {
        return request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids);
      }

      // Data-deletion (Play/GDPR) / "leave group" flow: the symmetric
      // opposite of a join -- removing ONLY your own uid, no one else's.
      // An empty memberUids list afterwards is a harmless orphaned doc, not
      // a security concern (the group itself still cannot be deleted --
      // see `allow delete: if false` below).
      function isSelfRemovalUpdate() {
        return request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.auth.uid in resource.data.memberUids
          && !(request.auth.uid in request.resource.data.memberUids);
      }

      allow update: if isSignedIn()
        && (isJoinUpdate() || isSelfRemovalUpdate())
        && request.resource.data.name == resource.data.name
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;

      // -----------------------------------------------------------------
      // groups/{groupId}/days/{date}/results/{uid}
      // -----------------------------------------------------------------
      match /days/{date}/results/{uid} {
        // Read only as a member of the parent group (spoiler safety is
        // enforced client-side by never fetching guesses/word — this rule
        // only gates group membership, per spec's data model which never
        // stores guesses or the secret here in the first place).
        allow get, list: if isMember(get(/databases/$(database)/documents/groups/$(groupId)).data);

        // CREATE-ONLY: a result is written once on finish and never
        // editable afterwards — no revising your score after seeing the
        // leaderboard. {uid} == request.auth.uid makes "no editing others"
        // structural, not just a field check. Fields constrained to sane
        // ranges. finishedAt == request.time (server timestamp, no
        // backdating) and guessesUsed/outcome are otherwise self-reported
        // by the client — accepted MVP anti-cheat posture per spec's
        // "Anti-cheat posture" section (friend-group social trust; a
        // determined user could still fake their OWN score).
        allow create: if isSignedIn()
          && uid == request.auth.uid
          && isValidDate(date)
          && isMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.resource.data.keys().hasOnly([
               'uid', 'displayName', 'outcome', 'guessesUsed', 'par', 'scoreVsPar', 'lang', 'finishedAt'
             ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName ==
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.outcome in ['win', 'loss']
          && request.resource.data.guessesUsed is int
          && request.resource.data.guessesUsed >= 1
          && request.resource.data.guessesUsed <= 200
          && request.resource.data.par is int
          && request.resource.data.par > 0
          && request.resource.data.par <= 200
          && request.resource.data.scoreVsPar is int
          && request.resource.data.scoreVsPar >= -200
          && request.resource.data.scoreVsPar <= 200
          && request.resource.data.lang in ['en', 'hi-en']
          && request.resource.data.finishedAt == request.time;

        allow update: if false;

        // Data-deletion (Play/GDPR): a user may delete ONLY their own past
        // result doc (their own scores/displayName in a group they may have
        // since left) -- deliberately not membership-gated like the
        // get/list rule above, since "delete my data" runs alongside/after
        // leaving a group's memberUids, at which point isMember() would
        // already be false. Deleting your own row (rather than editing it)
        // does not weaken the "no revising your score" anti-cheat posture
        // above -- you can only erase your own history, never rewrite it to
        // a better one, and this can never affect another member's data.
        allow delete: if isSignedIn() && uid == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------
    // Default deny — anything not explicitly matched above.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
