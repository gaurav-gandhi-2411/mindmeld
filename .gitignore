# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
# Root-only: `uv run` from repo root (e.g. deploy-warmer.ps1's guard-script
# steps) treats the root pyproject.toml (ruff config only, not a real uv
# project) as a project root and generates an empty lockfile here. Scoped
# with a leading slash so generator/uv.lock (a real, committed lockfile) is
# unaffected.
/uv.lock

# Generated payloads (samples are explicitly re-added below)
payloads/*
!payloads/samples/

# Model caches
.model-cache/

# Fine-tune training artifacts — large binaries, reproducible from the
# committed recipe (evals/finetune/{split,assemble_data,train,eval_model}.py
# + cached training data) + fixed seed. Not committed unless/until a
# fine-tune actually ships (see PLAN.md).
generator/evals/finetune/model/
generator/evals/finetune/checkpoints/
generator/evals/finetune/data/train_run.log
generator/evals/finetune/data/assemble_run.log

# Raw external corpus downloads (Aksharantar, IndicCorp v2) — large,
# re-fetchable from the committed recipe (evals/finetune/fetch_corpus_data.py)
# against the same public dataset revisions. Not committed.
generator/evals/finetune/data/raw/

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/android/.gradle/
app/android/local.properties
app/ios/Pods/
app/*.iml

# Secrets (defense in depth — none committed as of the 2026-07 security audit)
.env
.env.*
*serviceAccountKey*.json
*firebase-adminsdk*.json
*.pem

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Claude worktrees
.claude/worktrees/

# Web deploy staging
web-dist/

# Firebase emulator (rules tests)
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/
firebase-tests/node_modules/
firebase-tests/shot_*.png

